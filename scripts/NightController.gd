extends RefCounted

## After-hours composition helpers.
##
## Night scenes come from data.json. This controller appends the documents that
## are generated by the day's play: the email a student sends after the chat,
## and a short night-log line. Keeping it here stops the night flow from
## growing inside Main.gd's already crowded story section.

static func extra_docs(chat, last_student: Dictionary, tokens: Dictionary) -> Array:
	var out: Array = []
	if chat == null:
		return out
	var mail: Dictionary = chat.night_email(last_student, tokens)
	if !mail.is_empty():
		out.append(mail)
	return out

static func log_entry(day_index: int, label: String, tone: String) -> Dictionary:
	return {
		"day": day_index + 1,
		"label": label,
		"tone": tone,
	}

## A college thank-you letter earned by two clean passes.  The reward itself is
## paid when the second pass is stamped; this document is the story receipt.
static func college_letters(pending: Array, favor: Dictionary, tokens: Dictionary) -> Array:
	var out: Array = []
	for gid in pending:
		var group := CollegeModel.group(str(gid))
		if group.is_empty():
			continue
		var row := CollegeModel.entry(favor, str(gid))
		var advisor := CollegeModel.advisor_name(group)
		var director := CollegeModel.director_name(group)
		var student := str(row.get("lastStudent", "学生"))
		var passes := int(row.get("passes", 0))
		var label := str(group.get("label", ""))
		var letter := str(group.get("letter", ""))
		out.append({
			"id": "college-letter-" + str(gid),
			"tab": "感谢函",
			"icon": "谢",
			"badge": "学院回礼",
			"kind": "memo",
			"kicker": label + " / THANK YOU",
			"officeLeft": label,
			"officeRight": "内部便函 · 不编号",
			"title": "一封来自%s的感谢函" % label,
			"subtitle": "COLLEGE THANK-YOU",
			"meta": [
				{"k": "日期", "v": "{{date}}"},
				{"k": "来函", "v": advisor},
				{"k": "抄送", "v": director},
				{"k": "密级", "v": "内部"},
			],
			"sections": [
				{"h": "一、致谢", "p": "周老师：%s的论文在 03 窗口办结了。%s" % [student, letter]},
				{"h": "二、回礼", "p": "随函附上学院劳务 ¥%s，已计入本月绩效。规范通过累计 %d 件，学院记下这份人情。" % [
					Ui.fmt_money(CollegeModel.milestone_perf(group)), passes]},
			],
			"signature": "%s　%s" % [advisor, director],
			"seal": str(group.get("seal", "学院")),
			"sealSub": "已阅",
			"stamp": "已收悉",
			"note": "本函由学院办公室随夜班文件送达，阅后归入学院关系。",
		})
	return out
